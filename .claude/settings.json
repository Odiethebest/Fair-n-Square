{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm run db:migrate)",
      "Bash(npm run db:migrate *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(npx prisma migrate reset)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push --force-reset *)"
    ]
  },
  "plansDirectory": "./docs/plans"
}
